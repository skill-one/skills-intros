# Python bytecode
__pycache__/
*.py[cod]

# Generated profiles (output/) & upstream dataset cache (cache/skills-sh)
output/
cache/

# Local-only dotfiles: .env, .venv, .vscode, .pytest_cache, ... — all of them.
# Keep the workflows, and the committed .env.example template.
.*
!.github/
!.env.example
